    {
      "ribbon": {
        "icon": "bookmark",
        "label": "What It Is"
      }
    },
    {
      "grid": false,
      "text": [
        {
          "card": false,
          "blocks": [
            {
              "block": [
                {
                  "text": "The EB-2 NIW is a U.S. employment-based Green Card category for professionals with advanced degrees or exceptional ability whose work is considered to be in the national interest of the United States."
                }
              ],
              "lineBreak": true
            },
            {
              "block": [
                {
                  "text": "“NIW” means National Interest Waiver — a waiver of the usual job offer and labor certification (PERM) requirements."
                }
              ],
              "lineBreak": true
            },
            {
              "block": [
                {
                  "text": "In other words, you can self-petition without needing an employer to sponsor you."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "ribbon": {
        "icon": "bookmark",
        "label": "Who qualifies"
      }
    },
    {
      "grid": false,
      "text": [
        {
          "card": false,
          "blocks": [
            {
              "block": [
                {
                  "text": "You may qualify under the EB-2 category if you have:"
                }
              ],
              "lineBreak": true
            },
            {
              "block": [
                {
                  "text": "• An advanced degree (master’s, Ph.D., or bachelor’s + 5 years of progressive experience), or"
                }
              ]
            },
            {
              "block": [
                {
                  "text": "• Exceptional ability in your field (sciences, arts, or business)."
                }
              ]
            }
          ]
        }
      ]
    },
