                },
                {
                  "block": [
                    {
                      "text": "1.8 She decided to",
                      "correctAnswer": ["stand her ground"]
                    },
                    {
                      "text": "and not accept less pay."
                    }
                  ]
                },
                {
                  "block": [
                    {
                      "text": "1.9 He managed to",
                      "correctAnswer": ["drive a bargain"]
                    },
                    {
                      "text": "and got a better offer."
                    }
                  ]
                }
              ]
            }
          ]
        },
