  "contents": [
    {
      "audioPlayer": {
        "sticky": true,
        "src": "/assets/audio/specific-purposes/business/sbelaa/lesson-17.mp3"
      }
    },
    {
      "card": {
        "bgColor": "var(--gray-3)",
        "icon": "page",
        "label": "Lesson 17 • Telling Somebody Off",
        "descriptions": [
          {
            "description": [
              {
                "text": "Doug and Joe work at the reception desk of the Boston Empire Hotel, a large hotel. Kara, the hotel manager, yells at Doug for being late to work every day."
              }
            ]
          }
        ]
      }
    },
    {
      "text": [
        {
          ,
          "blocks": [
            {
              "block": [
                {
                  "boldText": "Doug: "
                },
                {
                  "text": "Good morning, guys. How's it going?"
                }
              ]
            }
          ]
        },
        {
          ,
          "blocks": [
            {
              "block": [
                {
                  "boldText": "Joe: "
                },
                {
                  "text": "Lousy. You were supposed to be here at 8 a.m. It's now 11 o'clock. "
                },
                {
                  "markedText": "What's the deal"
                },
                {
                  "text": "?"
                }
              ]
            }
          ]
        },
        {
          ,
          "blocks": [
            {
              "block": [
                {
                  "boldText": "Doug: "
                },
                {
                  "text": "Sorry about that. My alarm didn't go off this morning."
                }
              ]
            }
          ]
        },
        {
          ,
          "blocks": [
            {
              "block": [
                {
                  "boldText": "Kara: "
                },
                {
                  "text": "You've been late every day this week!"
                }
              ]
            }
          ]
        },
        {
          ,
          "blocks": [
            {
              "block": [
                {
                  "boldText": "Doug: "
                },
                {
                  "text": "I "
                },
                {
                  "markedText": "had a rough night"
                },
                {
                  "text": " last night. My girlfriend Liz "
                },
                {
                  "markedText": "dumped"
                },
                {
                  "text": " me and told me she's in love with my best friend!"
                }
              ]
            }
          ]
        },
        {
          ,
          "blocks": [
            {
              "block": [
                {
                  "boldText": "Kara: "
                },
                {
                  "text": "Oh please, "
                },
                {
                  "markedText": "spare us the sob story"
                },
                {
                  "text": "!"
                }
              ]
            }
          ]
        },
        {
          ,
          "blocks": [
            {
              "block": [
                {
                  "boldText": "Joe: "
                },
                {
                  "text": "I'm "
                },
                {
                  "markedText": "sick and tired of"
                },
                {
                  "text": " your excuses. You need to start "
                },
                {
                  "markedText": "pulling your weight"
                },
                {
                  "text": " around here."
                }
              ]
            }
          ]
        },
        {
          ,
          "blocks": [
            {
              "block": [
                {
                  "boldText": "Doug: "
                },
                {
                  "text": "Hey, "
                },
                {
                  "markedText": "cut me some slack"
                },
                {
                  "text": "! My life is a mess right now."
                }
              ]
            }
          ]
        },
        {
          ,
          "blocks": [
            {
              "block": [
                {
                  "boldText": "Kara: "
                },
                {
                  "text": "Doug, I'm trying to "
                },
                {
                  "markedText": "run a tight ship"
                },
                {
                  "text": ". I can't continue "
                },
                {
                  "markedText": "turning a blind eye "
                },
                {
                  "text": " to the fact that you're always late."
                },
                {
                  "markedText": "Shape up or ship out"
                },
                {
                  "text": "!"
                }
              ]
            }
          ]
        },
        {
          ,
          "blocks": [
            {
              "block": [
                {
                  "boldText": "Doug: "
                },
                {
                  "text": "I promise tomorrow I'll be here at 8 a.m. "
                },
                {
                  "markedText": "on the dot"
                },
                {
                  "text": "."
                }
              ]
            }
          ]
        },
        {
          ,
          "blocks": [
            {
              "block": [
                {
                  "italicText": "Telling Somebody Off, Part 2: The Next Day..."
                }
              ]
            }
          ]
        },
        {
          ,
          "blocks": [
            {
              "block": [
                {
                  "boldText": "Doug: "
                },
                {
                  "text": "Sorry, I'm "
                },
                {
                  "markedText": "running behind"
                },
                {
                  "text": ". I had to..."
                }
              ]
            }
          ]
        },
        {
          ,
          "blocks": [
            {
              "block": [
                {
                  "boldText": "Kara: "
                },
                {
                  "markedText": "Don't waste your breath"
                },
                {
                  "text": "! You're three hours late again."
                }
              ]
            }
          ]
        },
        {
          ,
          "blocks": [
            {
              "block": [
                {
                  "boldText": "Doug: "
                },
                {
                  "text": "But my car wouldn't start, my mechanic is on vacation in Florida, and then I..."
                }
              ]
            }
          ]
        },
        {
          ,
          "blocks": [
            {
              "block": [
                {
                  "boldText": "Kara: "
                },
                {
                  "text": "Today was "
                },
                {
                  "markedText": "the last straw"
                },
                {
                  "text": ". You're fired!"
                }
              ]
            }
          ]
        },
        {
          ,
          "blocks": [
            {
              "block": [
                {
                  "boldText": "Doug: "
                },
                {
                  "text": "That's fine. I was miserable working for a "
                },
                {
                  "markedText": "slave driver"
                },
                {
                  "text": " like you anyway!"
                }
              ]
            }
          ]
        },
        {
          ,
          "blocks": [
            {
              "block": [
                {
                  "boldText": "Kara: "
                },
                {
                  "text": "Don't "
                },
                {
                  "markedText": "burn your bridges"
                },
                {
                  "text": ". You may need me later as a reference."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
