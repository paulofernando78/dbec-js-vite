    },
    {
      "text": [
        {
          "images": [
            {
              "position": "right",
              "src": "/assets/images/extras/audiobooks/elementary/young-learners-adults/robin-hood/chapter-16.avif",
              "alt": "Chapter 16 image"
            }
          ],
          "blocks": [
            {
