    {
      "text": [
        {
          "images": [
            {
              "position": "left",
              "src": "/assets/images/extras/audiobooks/starter/young-learners-adults/flying-home/cover.avif",
              "alt": "Cover image"
            }
          ],
          "blocks": [
            {
              "block": [
                {
                  "text": "Felix is not a happy bird. He comes from Brazil but he doesn’t live there. He lives in New York in a cage. Then one day his cage opens and Felix says goodbye to New York. Can he find his family in Brazil again? Let’s find out."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "audioPlayer": {
        "sticky": true,
        "src": "/assets/audio/extras/audiobooks/starter/young-learners-adults/flying-home/audio.mp3"
      }
