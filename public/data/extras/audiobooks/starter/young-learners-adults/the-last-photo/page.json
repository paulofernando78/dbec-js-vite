                    {
                      "text": "..."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "ribbon": {
        "icon": "snippet",
        "label": "Paragraph 6 • 3:12"
      }
    },
    {
      "text": [
        {
          "images": [
            {
              "position": "right",
              "src": "/assets/images/extras/audiobooks/starter/young-learners-adults/the-last-photo/paragraph-6.avif",
              "alt": "Paragraph 6 image"
            }
          ],
          "blocks": [
            {
              "block": [
                {
                  "text": "Three days later, on Tuesday, Pam has got her photos from the shop. “Look at these”, she says to Martin. “They’re the photos of us in Cambridge.” “Oh, these are all very good,” says Martin. “But not this last one,” says Pam. “Look, it’s that man with the rucksack.”"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "exercises": [
        {
          "title": "1.1 Fill in the blank with the correct answer."
        },
        {
