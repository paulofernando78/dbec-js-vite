        "label": "Paragraph 15 • 8:28"
      }
    },
    {
      "text": [
        {
          "images": [
            {
              "position": "right",
              "src": "/assets/images/extras/audiobooks/starter/young-learners-adults/the-last-photo/paragraph-15.avif",
              "alt": "Paragraph 15 image"
            }
          ],
          "blocks": [
            {
              "block": [
                {
                  "text": "The people at the bank are very happy. They give Pam and Martin a thousand pounds. “My last photo’s a good one after all,” laughs Pam. Now I can buy a very good new camera."
                }
              ]
            }
          ]
        }
      ]
    }
