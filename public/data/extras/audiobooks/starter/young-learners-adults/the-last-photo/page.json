    },
    {
      "ribbon": {
        "icon": "snippet",
        "label": "Paragraph 11 • 6:19"
      }
    },
    {
      "text": [
        {
          "images": [
            {
              "position": "right",
              "src": "/assets/images/extras/audiobooks/starter/young-learners-adults/the-last-photo/paragraph-11.avif",
              "alt": "Paragraph 11 image"
            }
          ],
          "blocks": [
            {
              "block": [
                {
                  "text": "At the police station, Pam and Martin speak to a policeman. They put Pam’s photo and the newspaper on the table and they tell their story. “That’s Alan Rook,” says the policeman. “In Cambridge at 5 o’clock on Saturday. The big question is—where is he now?”"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "exercises": [
        {
          "title": "1.1 Fill in the blank with the correct answer."
        },
        {
          "fillExercises": [
