                  "block": [
                    {
                      "text": "1.1 ...",
                      "correctAnswer": ["..."]
                    },
                    {
                      "text": "..."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "ribbon": {
        "icon": "snippet",
        "label": "Paragraph 9 • 5:05"
      }
    },
    {
      "text": [
        {
          "images": [
            {
              "position": "right",
              "src": "/assets/images/extras/audiobooks/starter/young-learners-adults/the-last-photo/paragraph-9.avif",
              "alt": "Paragraph 9 image"
            }
          ],
          "blocks": [
            {
              "block": [
                {
                  "text": "“But is that the man in my photo?” asks Pam. “He hasn’t got a beard and he hasn’t any hair.” “Look at his ears. Look at his nose,” says Martin. “It’s him. I know it is.” Martin has an idea. He takes a pencil and starts to draw on the newspaper. “What are you doing?” asks Pam."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "exercises": [
        {
          "title": "1.1 Fill in the blank with the correct answer."
        },
        {
          "fillExercises": [
            {
              "card": false,
              "blocks": [
                {
                  "block": [
                    {
                      "text": "1.1 ...",
                      "correctAnswer": ["..."]
                    },
                    {
                      "text": "..."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "ribbon": {
        "icon": "snippet",
        "label": "Paragraph 10 • 5:43"
      }
    },
    {
      "text": [
        {
          "images": [
            {
              "position": "right",
              "src": "/assets/images/extras/audiobooks/starter/young-learners-adults/the-last-photo/paragraph-10.avif",
              "alt": "Paragraph 10 image"
            }
          ],
          "blocks": [
            {
              "block": [
                {
                  "text": "“Look,” says Martin. “I’m putting dark glasses and a two-day beard on the man in this photo. Now I’m drawing a hat on his head. See? Now, look at the two pictures.” “You’re right,” says Pam. “It’s him. It’s Alan Rook.” “Come on, says Martin. Let’s take these pictures to the police.”"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "exercises": [
        {
