                      "text": "1.1 ...",
                      "correctAnswer": ["..."]
                    },
                    {
                      "text": "..."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "ribbon": {
        "icon": "snippet",
        "label": "Paragraph 4 • 1:53"
      }
    },
    {
      "text": [
        {
          "images": [
            {
              "position": "right",
              "src": "/assets/images/extras/audiobooks/starter/young-learners-adults/the-last-photo/paragraph-4.avif",
              "alt": "Paragraph 4 image"
            }
          ],
          "blocks": [
            {
              "block": [
                {
                  "text": "The man looks at Pam. He is angry. He goes across the road without a word. “That man isn’t very nice, is he?” says Martin. “No”, says Pam. “And that was the last picture on the film, too.” The man with the rucksack on his back goes into the bus station. He’s got sunglasses and a blue hat."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "exercises": [
        {
          "title": "1.1 Fill in the blank with the correct answer."
        },
        {
          "fillExercises": [
            {
              "card": false,
              "blocks": [
                {
                  "block": [
                    {
                      "text": "1.1 ...",
                      "correctAnswer": ["..."]
                    },
                    {
                      "text": "..."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "ribbon": {
        "icon": "snippet",
        "label": "Paragraph 5 • 2:30"
      }
    },
    {
      "text": [
        {
          "images": [
            {
              "position": "right",
              "src": "/assets/images/extras/audiobooks/starter/young-learners-adults/the-last-photo/paragraph-5.avif",
              "alt": "Paragraph 5 image"
            }
          ],
          "blocks": [
            {
              "block": [
                {
                  "text": "“Come on,” says Martin. “Let’s find our bus.” They go into the bus station. “Look”, says Martin. “There’s that man again. He’s getting into that bus. He’s going to Aberdeen. That’s in Scotland.” “Good”, says Pam. “Far from here and far from me!” She is angry with the man."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "exercises": [
        {
          "title": "1.1 Fill in the blank with the correct answer."
        },
        {
          "fillExercises": [
