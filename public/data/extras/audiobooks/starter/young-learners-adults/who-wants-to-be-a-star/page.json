    {
      "ribbon": {
        "icon": "snippet",
        "label": "Paragraph 14 • 8:48"
      }
    },
    {
      "text": [
        {
          "images": [
            {
              "position": "right",
              "src": "/assets/images/extras/audiobooks/starter/young-learners-adults/who-wants-to-be-a-star/paragraph-14.avif",
              "alt": "Paragraph 14 image"
            }
          ],
          "blocks": [
            {
              "block": [
                {
                  "text": "Tina’s mother is very happy to see Tina again. Mrs. White explains her idea: Tina can go to her friend’s school on the Island of Guernsey, between England and France. Tina can have friends there who did not know she is Curls. “What? I want Tina to be a star!” Mrs. Daniel says. “She wants to be happy,” Mrs. White says quietly."
                }
              ]
            }
          ]
        }
      ]
    },
