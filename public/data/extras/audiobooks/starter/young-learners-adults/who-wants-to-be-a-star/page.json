    },
    {
      "ribbon": {
        "icon": "snippet",
        "label": "Paragraph 5 • 2:46"
      }
    },
    {
      "text": [
        {
          "images": [
            {
              "position": "right",
              "src": "/assets/images/extras/audiobooks/starter/young-learners-adults/who-wants-to-be-a-star/paragraph-5.avif",
              "alt": "Paragraph 5 image"
            }
          ],
          "blocks": [
            {
              "block": [
                {
                  "text": "Tina arrives at Stonechurch. She sees an old house near the river. It is the house in the photo! There are flowers and trees in the garden. “Mrs. White must live here,” Tina thinks. She goes to the front door and rings the bell. And an old lady with white hair and a kind face opens the door. A black cat comes out, too."
                }
              ]
            }
          ]
        }
      ]
    },
