    {
      "ribbon": {
        "icon": "snippet",
        "label": "Paragraph 6 • 3:23"
      }
    },
    {
      "text": [
        {
          "images": [
            {
              "position": "right",
              "src": "/assets/images/extras/audiobooks/starter/young-learners-adults/who-wants-to-be-a-star/paragraph-6.avif",
              "alt": "Paragraph 6 image"
            }
          ],
          "blocks": [
            {
              "block": [
                {
                  "text": "“Good afternoon, who are you?” the old lady asks. “Oh, hello, Mrs. White. My name is Tina. I am a schoolfriend of your granddaughter, Mary.” “Mary’s schoolfriend—how nice to meet you! What are you doing in Stonechurch, Tina?” Mrs. White asks. Tina says she hates the city life. “Well,” says Mrs. White, “Come in and have a cup of tea, my dear.”"
                }
              ]
            }
          ]
        }
      ]
    },
