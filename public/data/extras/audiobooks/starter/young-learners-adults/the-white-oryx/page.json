        }
      ]
    },
    {
      "ribbon": {
        "icon": "snippet",
        "label": "Paragraph 2 • 0:47"
      }
    },
    {
      "text": [
        {
          "images": [
            {
              "position": "right",
              "src": "/assets/images/extras/audiobooks/starter/young-learners-adults/the-white-oryx/paragraph-2.avif",
              "alt": "Paragraph 2 image"
            }
          ],
          "blocks": [
            {
              "block": [
                {
                  "text": "“We put little radios on the oryx,” Abdullah says. “You can see one there, on its neck. With the radios we can usually find them.” Suddenly there is a noise behind them. It is the big radio in the car. The oryx look up and run away quickly. “Abdullah!” the radio says. “Can you hear me? There’s a problem in Wadi Bidbid. Perhaps poachers.”"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "exercises": [
        {
          "title": "1.1 Fill in the blank with the correct answer."
        },
        {
          "fillExercises": [
            {
              "card": false,
              "blocks": [
                {
                  "block": [
                    {
                      "text": "1.1 ...",
                      "correctAnswer": ["..."]
                    },
                    {
                      "text": "..."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "ribbon": {
        "icon": "snippet",
        "label": "Paragraph 3 • 1:29"
      }
    },
    {
      "text": [
        {
          "images": [
            {
              "position": "right",
              "src": "/assets/images/extras/audiobooks/starter/young-learners-adults/the-white-oryx/paragraph-3.avif",
              "alt": "Paragraph 3 image"
            }
          ],
          "blocks": [
            {
              "block": [
                {
                  "text": "“I’m very near there,” Abdullah says. “I can go there, but I’ve got the Australian woman with me.” “That’s OK,” Mandy says. ’I can come with you. Perhaps I can help you.” “OK,” Abdullah says. “Let’s go.” Mandy gets into the car and they drive away quickly across the desert."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "exercises": [
        {
          "title": "1.1 Fill in the blank with the correct answer."
        },
        {
          "fillExercises": [
            {
              "card": false,
