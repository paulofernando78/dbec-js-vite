    {
      "ribbon": {
        "icon": "snippet",
        "label": "Paragraph 15 • 9:00"
      }
    },
    {
      "text": [
        {
          "images": [
            {
              "position": "right",
              "src": "/assets/images/extras/audiobooks/starter/young-learners-adults/the-white-oryx/paragraph-15.avif",
              "alt": "Paragraph 15 image"
            }
          ],
          "blocks": [
            {
              "block": [
                {
                  "text": "“It’s a good day for me, too.” Mandy smiles. “I’ve got some very interesting pictures for my book about the animals of the desert.” “Perhaps you can write a new book,” the policeman says. “A book about the oryx poachers and the famous ranger, Abdullah.” “Why not?” Mandy smiles again."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
