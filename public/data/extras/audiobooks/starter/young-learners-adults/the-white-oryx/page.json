    },
    {
      "ribbon": {
        "icon": "snippet",
        "label": "Paragraph 7 • 3:53"
      }
    },
    {
      "text": [
        {
          "images": [
            {
              "position": "right",
              "src": "/assets/images/extras/audiobooks/starter/young-learners-adults/the-white-oryx/paragraph-7.avif",
              "alt": "Paragraph 7 image"
            }
          ],
          "blocks": [
            {
              "block": [
                {
                  "text": "They drive quickly across the desert again. Mandy is watching the tracks. Abdullah is talking on the radio. “One mother oryx is dead,” he says. “But the poachers have got her baby. We’re following them.” Abdullah listens to the radio and smiles. “That’s good,” he says to Mandy. “The police have a helicopter near here. They’re coming, too.”"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "exercises": [
        {
          "title": "1.1 Fill in the blank with the correct answer."
        },
        {
