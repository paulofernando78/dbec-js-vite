    },
    {
      "ribbon": {
        "icon": "snippet",
        "label": "Paragraph 11 • 6:27"
      }
    },
    {
      "text": [
        {
          "images": [
            {
              "position": "right",
              "src": "/assets/images/extras/audiobooks/starter/young-learners-adults/the-white-oryx/paragraph-11.avif",
              "alt": "Paragraph 11 image"
            }
          ],
          "blocks": [
            {
              "block": [
                {
                  "text": "Abdullah starts the car again. But it is in the sand now and it doesn’t move. He goes in front of the car with his gun. Mandy goes behind the car. Suddenly there is a very loud noise and they see a helicopter in front of them. It makes a big cloud of sand and the poachers can’t see the road. The truck stops in the sand and two men run from it into the desert."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "exercises": [
        {
          "title": "1.1 Fill in the blank with the correct answer."
