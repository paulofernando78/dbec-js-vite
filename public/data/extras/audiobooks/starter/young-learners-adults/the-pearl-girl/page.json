    {
      "ribbon": {
        "icon": "snippet",
        "label": "Paragraph 1"
      }
    },
    {
      "text": [
        {
          "images": [
            {
              "position": "right",
              "src": "/assets/images/extras/audiobooks/starter/young-learners-adults/the-pearl-girl/paragraph-1.avif",
              "alt": "Paragraph 1 image"
            }
          ],
          "blocks": [
            {
              "block": [
                {
                  "text": "Kate Grant is fifteen and comes from Canada. She is visiting the Netherlands with her mother and father. On June 8th, the Grants are at a museum in The Hague. “This is very good”. Mr. Grant says. He is looking at a picture of an old man. “Yes,” Mrs. Grants says. “What do you think, Kate?” “It’s OK,” Kate says. She looks at her watch. It is four forty-five."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "grid": false,
      "text": [
        {
          "blocks": [
            {
              "block": [
                {
                  "boldText": "Museum where paiting is located."
                }
              ]
            },
            {
              "block": [
                {
                  "links": [
                    {
                      "icon": "link",
                      "link": "https://www.mauritshuis.nl/en?gad_source=1&gad_campaignid=1613811005&gbraid=0AAAAADuJqF3YcslnWB29ontFfhA6ZG1VZ&gclid=Cj0KCQjwnJfEBhCzARIsAIMtfKLiw6STAj1Jwpelnptlk1q3Z845Zyq0wJiHP3bd2gLaTQFXxlj7xRoaAottEALw_wcB",
                      "target": "_blank",
                      "label": "Mauritshuis"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
