    },
    {
      "ribbon": {
        "icon": "snippet",
        "label": "Paragraph 5 • 3:14"
      }
    },
    {
      "text": [
        {
          "images": [
            {
              "position": "right",
              "src": "/assets/images/extras/audiobooks/starter/young-learners-adults/the-pearl-girl/paragraph-5.avif",
              "alt": "Paragraph 5 image"
            }
          ],
          "blocks": [
            {
              "block": [
                {
                  "text": "Kate goes into the museum with Paul Van Dyck. It is dark and there aren’t any people in the rooms. “Where is the passport?” Paul asks. “Do you know?” “Yes. It’s on a chair near that picture of a girl with an earring,” Kate says. They walk for a minute, then Paul Van Dyck stops. “Sshh!” he says. “I can hear voices.”"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "exercises": [
