    {
      "ribbon": {
        "icon": "snippet",
        "label": "Paragraph 6 • 3:56"
      }
    },
    {
      "text": [
        {
          "images": [
            {
              "position": "right",
              "src": "/assets/images/extras/audiobooks/starter/young-learners-adults/the-pearl-girl/paragraph-6.avif",
              "alt": "Paragraph 6 image"
            }
          ],
          "blocks": [
            {
              "block": [
                {
                  "text": "Kate looks at Paul. He isn’t smiling now. Then she hears voices, too. “Be very, very quiet,” Paul says. He takes a phone from his coat pocket, but suddenly there are two men in the room. One is tall and has a big, black bag in his hands. The short man has a gun. They look at Kate and Paul. Kate and Paul look a(t) the men. Time stops."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "exercises": [
        {
          "title": "1.1 Fill in the blank with the correct answer."
