    {
      "text": [
        {
          "images": [
            {
              "position": "right",
              "src": "/assets/images/extras/audiobooks/starter/kids/puss-in-boots/cover.avif",
              "alt": "Cover image"
            }
          ],
          "blocks": [
            {
              "block": [
                {
                  "text": "Puss-in-Boots is a very unusual and clever cat. He wears long boots and is so clever that by his actions he makes his master a rich and happy man."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "exercises": [
        {
          "title": "Choose the correct answer.",
          "description": "Description"
        },
        {
          "radioExercises": [
            {
              "question": [
                {
                  "text": "What does Puss-in-Boots wear?"
                }
              ],
              "options": [
                { "option": "a) He likes to wear shoes.", "isCorrect": false },
                { "option": "b) He likes to wear boots.", "isCorrect": true }
              ]
            }
          ]
        }
      ]
    },
    {
      "audioPlayer": {
        "sticky": true,
        "src": "/assets/audio/extras/audiobooks/starter/kids/puss-in-boots/audio.mp3"
      }
    },
    {
      "ribbon": {
        "icon": "snippet",
        "label": "Paragraph 1"
      }
    },
    {
      "text": [
        {
          "images": [
            {
              "position": "right",
              "src": "/assets/images/extras/audiobooks/starter/kids/puss-in-boots/paragraph-1.avif",
              "alt": "Paragraph 1 image"
            }
          ],
          "blocks": [
            {
              "block": [
                {
                  "text": "Once upon a time, there was a poor farmer who had a very clever cat."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "ribbon": {
        "icon": "snippet",
        "label": "Paragraph 2"
      }
    },
    {
      "text": [
        {
          "images": [
            {
              "position": "right",
              "src": "/assets/images/extras/audiobooks/starter/kids/puss-in-boots/paragraph-2.avif",
              "alt": "Paragraph 2 image"
            }
          ],
          "blocks": [
            {
              "block": [
                {
                  "text": "“My name's Puss-in-Boots!” The cat said. “Master, I can talk, I'd like to help you.”"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "ribbon": {
        "icon": "snippet",
        "label": "Paragraph 3"
      }
    },
    {
      "text": [
        {
          "images": [
            {
              "position": "right",
              "src": "/assets/images/extras/audiobooks/starter/kids/puss-in-boots/paragraph-3.avif",
              "alt": "Paragraph 3 image"
            }
          ],
          "blocks": [
            {
              "block": [
                {
                  "text": "Then Puss-in-Boots went into the forest. He caught a big fat rabbit in his bag."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "ribbon": {
        "icon": "snippet",
        "label": "Paragraph 4"
      }
    },
    {
      "text": [
        {
          "images": [
            {
              "position": "right",
              "src": "/assets/images/extras/audiobooks/starter/kids/puss-in-boots/paragraph-4.avif",
              "alt": "Paragraph 4 image"
            }
          ],
          "blocks": [
            {
              "block": [
                {
                  "text": "He took the rabbit to the king."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "ribbon": {
        "icon": "snippet",
        "label": "Paragraph 5"
      }
    },
    {
      "text": [
        {
          "images": [
            {
              "position": "right",
              "src": "/assets/images/extras/audiobooks/starter/kids/puss-in-boots/paragraph-5.avif",
              "alt": "Paragraph 5 image"
            }
          ],
          "blocks": [
            {
              "block": [
                {
                  "text": "“This present is from my master,” he said."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "ribbon": {
        "icon": "snippet",
        "label": "Paragraph 6"
      }
    },
    {
      "text": [
        {
          "images": [
            {
              "position": "right",
              "src": "/assets/images/extras/audiobooks/starter/kids/puss-in-boots/paragraph-6.avif",
              "alt": "Paragraph 6 image"
            }
          ],
          "blocks": [
            {
              "block": [
                {
                  "text": "Later, Puss said to his master, ”take off your clothes and jump in the river!“"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "ribbon": {
        "icon": "snippet",
        "label": "Paragraph 7"
      }
    },
    {
      "text": [
        {
          "images": [
            {
              "position": "right",
              "src": "/assets/images/extras/audiobooks/starter/kids/puss-in-boots/paragraph-7.avif",
              "alt": "Paragraph 7 image"
            }
          ],
          "blocks": [
            {
              "block": [
                {
                  "text": "“Quick!” Puss said to the king and his daughter. “My master is in the water!”"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "ribbon": {
        "icon": "snippet",
        "label": "Paragraph 8"
      }
    },
    {
      "text": [
        {
          "images": [
            {
              "position": "right",
              "src": "/assets/images/extras/audiobooks/starter/kids/puss-in-boots/paragraph-8.avif",
              "alt": "Paragraph 8 image"
            }
          ],
          "blocks": [
            {
              "block": [
                {
                  "text": "The king gave the farmer dry clothes. They were beautiful. The farmer looked very handsome."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "ribbon": {
        "icon": "snippet",
        "label": "Paragraph 9"
      }
    },
    {
      "text": [
        {
          "images": [
            {
              "position": "right",
              "src": "/assets/images/extras/audiobooks/starter/kids/puss-in-boots/paragraph-9.avif",
              "alt": "Paragraph 9 image"
            }
          ],
          "imgAlt": "Paragraph 9 image",
          "blocks": [
            {
              "block": [
                {
                  "text": "Puss-in-Boots saw a big castle. “A monster lives here,” Puss said, “but I'm not scared!”"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "ribbon": {
        "icon": "snippet",
        "label": "Paragraph 10"
      }
    },
    {
      "text": [
        {
          "images": [
            {
              "position": "right",
              "src": "/assets/images/extras/audiobooks/starter/kids/puss-in-boots/paragraph-10.avif",
              "alt": "Paragraph 10 image"
            }
          ],
          "blocks": [
            {
              "block": [
                {
                  "text": "“Show me some magic!” Puss said to the monster. “Can you change into a mouse?”"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "ribbon": {
        "icon": "snippet",
        "label": "Paragraph 11"
      }
    },
    {
      "text": [
        {
          "images": [
            {
              "position": "right",
              "src": "/assets/images/extras/audiobooks/starter/kids/puss-in-boots/paragraph-11.avif",
              "alt": "Paragraph 11 image"
            }
          ],
          "blocks": [
            {
              "block": [
                {
                  "text": "“Yes”, the monster said — he was very silly! He changed into a mouse. Puss jumped!"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "ribbon": {
        "icon": "snippet",
        "label": "Paragraph 12"
      }
    },
    {
      "text": [
        {
          "images": [
            {
              "position": "right",
              "src": "/assets/images/extras/audiobooks/starter/kids/puss-in-boots/paragraph-12.avif",
              "alt": "Paragraph 12 image"
            }
          ],
          "blocks": [
            {
              "block": [
                {
                  "text": "Puss showed the castle to the king and princess. Puss and his master lived there."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "ribbon": {
        "icon": "snippet",
        "label": "Paragraph 13"
      }
    },
    {
      "text": [
        {
          "images": [
            {
              "position": "right",
              "src": "/assets/images/extras/audiobooks/starter/kids/puss-in-boots/paragraph-13.avif",
              "alt": "Paragraph 13 image"
            }
          ],
          "blocks": [
            {
              "block": [
                {
                  "text": "His master was now very rich. He married the princess. They had a big party!"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "ribbon": {
        "icon": "snippet",
        "label": "Paragraph 14"
      }
    },
    {
      "text": [
        {
          "imgPosition": "right",
          "images": [
            {
              "position": "right",
              "src": "/assets/images/extras/audiobooks/starter/kids/puss-in-boots/paragraph-14.avif",
              "alt": "Paragraph 14 image"
            }
          ],
          "blocks": [
            {
              "block": [
                {
                  "text": "“Now, everyone is happy,” Puss said. “What a very clever cat I am.” “Purrrrrrrrrrrrrrrrr!”"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
