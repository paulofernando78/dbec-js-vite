                {
                  "audioSrc": "/assets/audio/extras/grammar/elementary/unit-15/c-3.mp3"
                },
                {
                  "text": "We’"
                },
                {
                  "markedText": "ve bought"
                },
                {
                  "text": " a new car. (we have a new car "
                },
                {
                  "italicText": "now"
                },
                {
                  "text": ")"
                }
              ]
            },
            {
              "block": [
                {
                  "boldText": "• "
