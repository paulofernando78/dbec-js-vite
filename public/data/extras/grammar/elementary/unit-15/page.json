              "lineBreak": true
            },
            {
              "block": [
                {
                  "boldText": "• "
                },
                {
                  "audioSrc": "/assets/audio/extras/grammar/elementary/unit-15/c-1.mp3"
                },
                {
                  "text": "I"
                },
                {
                  "markedText": "’ve lost"
                },
                {
                  "text": " my passport. (I can’t find my passport "
                },
                {
                  "italicText": "now"
                },
                {
                  "text": ")"
                }
              ]
            },
            {
              "block": [
                {
                  "boldText": "• "
                },
                {
                  "audioSrc": "/assets/audio/extras/grammar/elementary/unit-15/c-2.mp3"
                },
                {
                  "text": "A: “Where’s Rebecca?” B: “She"
                },
                {
                  "markedText": "’s gone"
                },
                {
                  "text": " to bed.” (she’s in bed "
                },
                {
                  "italicText": "now"
                },
                {
                  "text": ")"
                }
              ]
            },
            {
              "block": [
                {
                  "boldText": "• "
