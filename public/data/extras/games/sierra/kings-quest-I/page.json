      {
        "icon": "page",
        "description": "(1984) King’s Quest I: Quest for the Crown"
      }
    ]
  },
  "contents": [
    {
      "grid": false,
      "text": [ 
        {
          "images": [
            {
              "width": "80%",
              "position": "top",
              "src": "/assets/images/extras/games/sierra/kings-quest-I.jpg",
              "alt": "King’s Quest I box"
            }
          ],
          "blocks": [
            {
              "audioPlayer": {
                "src": "/assets/audio/extras/games/sierra/kings-quest-I/intro.mp3"
              },
              "block": [
                {
                  "boldText": "Become Sir Graham, bravest of knights. Locate and return to King Edward the lost treasures of the Kingdom of Daventry, so that you may inherit the throne. Be prepared. The journey will surely prove long and treacherous. You may choose among many paths open to you. The more elever and resourceful you prove yourself, the greater your reward."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "iframe": {
        "sticky": true,
        "src": "https://archive.org/embed/msdos_Kings_Quest_I_-_Quest_for_the_Crown_1987",
        "width": "80%",
        "height": "482px"
      }
    },
    {
      "ribbon": {
        "icon": "map",
        "label": "Game’s Walkthrough"
      }
    },
    {
      "text": [
        {
          "card": true,
          "blocks": [
            {
              "block": [
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/stage-1.mp3"
                },
                {
                  "boldText": "Stage 1: Enter the Castle"
                }
              ],
              "lineBreak": true
            },
            {
              "block": [
                {
                  "boldText": "1.1 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/1-1.mp3"
                },
                {
                  "text": "Walk to the castle door and open it."
                }
              ]
            },
            {
              "block": [
                {
                  "boldText": "1.2 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/1-2.mp3"
                },
                {
                  "text": "Enter the castle and bow to King Edward."
                }
              ]
            },
            {
              "block": [
                {
                  "boldText": "1.3 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/1-3.mp3"
                },
                {
                  "text": "Talk to him to learn about Graham’s quest."
                }
              ]
            },
            {
              "block": [
                {
                  "boldText": "1.4 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/1-4.mp3"
                },
                {
                  "text": "Leave the castle."
                }
              ]
            }
          ]
        },
        {
          "card": true,
          "blocks": [
            {
              "block": [
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/stage-2.mp3"
                },
                {
                  "boldText": "Stage 2: Dagger Retrieval"
                }
              ],
              "lineBreak": true
            },
            {
              "block": [
                {
                  "boldText": "2.1 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/2-1.mp3"
                },
                {
                  "text": "Go left to the screen with a large rock."
                }
              ]
            },
            {
              "block": [
                {
                  "boldText": "2.2 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/2-2.mp3"
                },
                {
                  "text": "Stand north of the rock and push it down to reveal a hole (standing south = death)."
                }
              ]
            },
            {
              "block": [
                {
                  "boldText": "2.3 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/2-3.mp3"
                },
                {
                  "text": "Look into the hole and take the dagger."
                }
              ]
            }
          ]
        },
        {
          "card": true,
          "blocks": [
            {
              "block": [
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/stage-3.mp3"
                },
                {
                  "boldText": "Stage 3: Golden Egg"
                }
              ],
              "lineBreak": true
            },
            {
              "block": [
                {
                  "boldText": "3.1 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/3-1.mp3"
                },
                {
                  "text": "Go up one screen to an oak tree."
                }
              ]
            },
            {
              "block": [
                {
                  "boldText": "3.2 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/3-2.mp3"
                },
                {
                  "text": "Look at the tree and climb it."
                }
              ]
            },
            {
              "block": [
                {
                  "boldText": "3.3 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/3-3.mp3"
                },
                {
                  "text": "Save game before moving on the branches."
                }
              ]
            },
            {
              "block": [
                {
                  "boldText": "3.4 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/3-4.mp3"
                },
                {
                  "text": "Walk carefully to the egg nest, look at it, and take the golden egg."
                }
              ]
            },
            {
              "block": [
                {
                  "boldText": "3.5 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/3-5.mp3"
                },
                {
                  "text": "Climb back down the tree."
                }
              ]
            }
          ]
        },
        {
          "card": true,
          "blocks": [
            {
              "block": [
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/stage-4.mp3"
                },
                {
                  "boldText": "Stage 4: Carrot & Magic Ring"
                }
              ],
              "lineBreak": true
            },
            {
              "block": [
                {
                  "boldText": "4.1 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/4-1.mp3"
                },
                {
                  "text": "Go right one screen to the carrot patch."
                }
              ]
            },
            {
              "block": [
                {
                  "boldText": "4.2 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/4-2.mp3"
                },
                {
                  "text": "Take a plump carrot (do not eat it)."
                }
              ]
            },
            {
              "block": [
                {
                  "boldText": "4.3 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/4-3.mp3"
                },
                {
                  "text": "Go up one screen to the elf area; leave and return until the elf appears."
                }
              ]
            },
            {
              "block": [
                {
                  "boldText": "4.4 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/4-4.mp3"
                },
                {
                  "text": "Talk to the elf to receive the magic ring."
                }
              ]
            },
            {
              "block": [
                {
                  "boldText": "4.5 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/4-5.mp3"
                },
                {
                  "text": "Go up one screen and take the bowl; look into it to see a word."
                }
              ]
            }
          ]
        },
        {
          "card": true,
          "blocks": [
            {
              "block": [
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/stage-5.mp3" },
                { "boldText": "Stage 5: Walnut & Pouch" }
              ],
              "lineBreak": true
            },
            {
              "block": [
                { "boldText": "5.1 " },
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/5-1.mp3" },
                { "text": "Go left one screen to the walnut tree and pick walnut from the ground, then open it." }
              ]
            },
            {
              "block": [
                { "boldText": "5.2 " },
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/5-2.mp3" },
                { "text": "Go up and right   to the lake edge, and get pebbles here." }
              ]
            },
            {
              "block": [
                { "boldText": "5.3 " },
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/5-3.mp3" },
                { "text": "Go left two screens to a stump and log. Look inside the stump and take the pouch with diamonds." }
              ]
            }
          ]
        },
        {
          "card": true,
          "blocks": [
            {
              "block": [
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/stage-6.mp3" },
                { "boldText": "Stage 6: Woodcutter & Fiddle" }
              ],
              "lineBreak": true
            },
            {
              "block": [
                { "boldText": "6.1 " },
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/6-1.mp3" },
                { "text": "Go right one screen and down one screen to the woodcutter’s house. Talk to the woodcutter." }
              ]
            },
            {
              "block": [
                { "boldText": "6.2 " },
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/6-2.mp3" },
                { "text": "Give the empty bowl and write ”fill”." }
              ]
            },
            {
              "block": [
                { "boldText": "6.3 " },
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/6-3.mp3" },
                { "text": "Take the fiddle, play it inside, then leave." }
              ]
            }
          ]
        },
        {
          "card": true,
          "blocks": [
            {
              "block": [
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/stage-7.mp3" },
                { "boldText": "Stage 7: Witch’s Gingerbread House" }
              ],
              "lineBreak": true
            },
            {
              "block": [
                { "boldText": "7.1 " },
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/7-1.mp3" },
                { "text": "Go down two screens to the witch’s house. Eat some of the house to score." }
              ]
            },
            {
              "block": [
                { "boldText": "7.2 " },
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/7-2.mp3" },
                { "text": "Enter only if the witch is absent (check / leave / return as needed)." }
              ]
            },
            {
              "block": [
                { "boldText": "7.3 " },
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/7-3.mp3" },
                { "text": "Take the note in the bedroom, read it, then push the witch into the pot when she appears." }
              ]
            },
            {
              "block": [
                { "boldText": "7.4 " },
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/7-4.mp3" },
                { "text": "Take the cheese from the cupboard and leave." }
              ]
            }
          ]
        },
        {
          "card": true,
          "blocks": [
            {
              "block": [
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/stage-8.mp3" },
                { "boldText": "Stage 8: Clover & Fairy Godmother" }
              ],
              "lineBreak": true
            },
            {
              "block": [
                { "boldText": "8.1 " },
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/8-1.mp3" },
                { "text": "Go left three screens and down one screen to the clover patch. Take a four-leaf clover." }
              ]
            },
            {
              "block": [
                { "boldText": "8.2 " },
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/8-2.mp3" },
                { "text": "Go south one screen to the fairy godmother area. Leave/return until she appears." }
              ]
            },
            {
              "block": [
                { "boldText": "8.3 " },
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/8-3.mp3" },
                { "text": "Receive a temporary protective spell (can be repeated)." }
              ]
            }
          ]
        },
        {
          "card": true,
          "blocks": [
            {
              "block": [
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/stage-9.mp3" },
                { "boldText": "Stage 9: Well & Dragon’s Cave" }
              ],
              "lineBreak": true
            },
            {
              "block": [
                { "boldText": "9.1 " },
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/9-1.mp3" },
                { "text": "Go right three screens to the well. Cut the rope with the dagger and take the bucket." }
              ]
            },
            {
              "block": [
                { "boldText": "9.2 " },
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/9-2.mp3" },
                { "text": "Climb down, fill the bucket, dive underwater to the cave opening." }
              ]
            },
            {
              "block": [
                { "boldText": "9.3 " },
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/9-3.mp3" },
                { "text": "Enter the dragon’s cave. Use bucket of water on dragon instead of dagger. Take the magic mirror." }
              ]
            }
          ]
        },
        {
          "card": true,
          "blocks": [
            {
              "block": [
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/stage-10.mp3" },
                { "boldText": "Stage 10: Goat & Troll" }
              ],
              "lineBreak": true
            },
            {
              "block": [
                { "boldText": "10.1 " },
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/10-1.mp3" },
                { "text": "Go to the goat pen. Open the gate and show the goat the carrot so it follows you." }
              ]
            },
            {
              "block": [
                { "boldText": "10.2 " },
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/10-2.mp3" },
                { "text": "Lead the goat to the troll bridge. It will knock the troll away." }
              ]
            }
          ]
        },
        {
          "card": true,
          "blocks": [
            {
              "block": [
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/stage-11.mp3" },
                { "boldText": "Stage 11: Rumplestiltskin & Beanstalk" }
              ],
              "lineBreak": true
            },
            {
              "block": [
                { "boldText": "11.1 " },
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/11-1.mp3" },
                { "text": "Talk to the gnome and solve his name puzzle using backwards alphabet. Receive beans." }
              ]
            },
            {
              "block": [
                { "boldText": "11.2 " },
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/11-2.mp3" },
                { "text": "Plant the beans in the flower patch to grow a giant beanstalk." }
              ]
            },
            {
              "block": [
                { "boldText": "11.3 " },
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/11-3.mp3" },
                { "text": "Save game and climb the beanstalk to reach the Land of the Clouds." }
              ]
            }
          ]
        },
        {
          "card": true,
          "blocks": [
            {
              "block": [
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/stage-12.mp3" },
                { "boldText": "Stage 12: Slingshot & Giant" }
              ],
              "lineBreak": true
            },
            {
              "block": [
                { "boldText": "12.1 " },
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/12-1.mp3" },
                { "text": "Find the tree with a hole. Take the slingshot." }
              ]
            },
            {
              "block": [
                { "boldText": "12.2 " },
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/12-2.mp3" },
                { "text": "Use sling to knock the giant down." }
              ]
            },
            {
              "block": [
                { "boldText": "12.3 " },
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/12-3.mp3" },
                { "text": "Take the magic chest and leave via stairs / wooden path and save game." }
              ]
            }
          ]
        },
        {
          "card": true,
          "blocks": [
            {
              "block": [
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/stage-13.mp3" },
                { "boldText": "Stage 13: Condor & Leprechaun" }
              ],
              "lineBreak": true
            },
            {
              "block": [
                { "boldText": "13.1 " },
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/13-1.mp3" },
                { "text": "At dragon cave exit, wait for condor. Jump to grab it and get carried away." }
              ]
            },
            {
              "block": [
                { "boldText": "13.2 " },
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/13-2.mp3" },
                { "text": "Land, go left one screen to take the mushroom, then fall into the hole to leprechaun area." }
              ]
            },
            {
              "block": [
                { "boldText": "13.3 " },
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/13-3.mp3" },
                { "text": "Give cheese to the rat, play fiddle to make leprechauns dance, then take scepter and shield." }
              ]
            }
          ]
        },
        {
          "card": true,
          "blocks": [
            {
              "block": [
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/stage-14.mp3" },
                { "boldText": "Stage 14: Miniature & Ending" }
              ],
              "lineBreak": true
            },
            {
              "block": [
                { "boldText": "14.1 " },
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/14-1.mp3" },
                { "text": "Eat the mushroom to shrink, exit hole, and return to normal size." }
              ]
            },
            {
              "block": [
                { "boldText": "14.2 " },
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/14-2.mp3" },
                { "text": "Go up two screens and right one screen to the castle." }
              ]
            },
            {
              "block": [
                { "boldText": "14.3 " },
                { "audio": true, "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/14-3.mp3" },
                { "text": "Open the door, enter the throne room, and bow to King Edward. Game complete!" }
              ]
            }
          ]
        }
      ]
    }
  ]
}
