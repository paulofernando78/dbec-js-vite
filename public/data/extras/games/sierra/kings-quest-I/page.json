  },
  "contents": [
    {
      "grid": false,
      "text": [
        {
          "images": [
            {
              "width": "80%",
              "position": "top",
              "src": "/assets/images/extras/games/sierra/kings-quest-I.jpg",
              "alt": "King’s Quest I box"
            }
          ],
          "blocks": [
            {
              "audioPlayer": {
                "src": "/assets/audio/extras/games/sierra/kings-quest-I/intro.mp3"
              },
              "block": [
                {
                  "boldText": "Become Sir Graham, bravest of knights. Locate and return to King Edward the lost treasures of the Kingdom of Daventry, so that you may inherit the throne. Be prepared. The journey will surely prove long and treacherous. You may choose among many paths open to you. The more elever and resourceful you prove yourself, the greater your reward."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "iframe": {
        "sticky": true,
        "src": "https://archive.org/embed/msdos_Kings_Quest_I_-_Quest_for_the_Crown_1987",
        "width": "80%",
        "height": "482px"
      }
    },
    {
      "ribbon": {
        "icon": "map",
        "label": "Game’s Walkthrough"
      }
    },
    {
      "text": [
        {
          "card": true,
          "blocks": [
            {
              "block": [
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/stage-1.mp3"
                },
                {
                  "boldText": "Stage 1: Beginning the Quest"
                }
              ],
              "lineBreak": true
            },
            {
              "block": [
                {
                  "boldText": "1.1 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/1-1.mp3"
                },
                {
                  "text": "Start in the throne room of Castle Daventry."
                }
              ]
            },
            {
              "block": [
                {
                  "boldText": "1.2 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/1-2.mp3"
                },
                {
                  "text": "King Edward’s charge: Recover the kingdom’s three lost treasures:"
                }
              ]
            },
            {
              "block": [
                {
                  "textIndent": true,
                  "boldText": "1.2.1 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/1-2-1.mp3"
                },
                {
                  "text": "Magic Mirror"
                }
              ]
            },
            {
              "block": [
                {
                  "textIndent": true,
                  "boldText": "1.2.2 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/1-2-3.mp3"
                },
                {
                  "text": "Magic Shield"
                }
              ]
            },
            {
              "block": [
                {
                  "textIndent": true,
                  "boldText": "1.2.4 "
                },
                {
                  "text": "Magic Chest"
                }
              ]
            },
            {
              "block": [
                {
                  "boldText": "1.3 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/1-3.mp3"
                },
                {
                  "text": "Step outside the castle; the land opens for exploration."
                }
              ]
            },
            {
              "block": [
                {
                  "boldText": "1.4 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/1-4.mp3"
                },
                {
                  "text": "Save your progress frequently to avoid instant death from wolves, ogres, or the sorcerer at night."
                }
              ]
            }
          ]
        },
        {
          "card": true,
          "blocks": [
            {
              "block": [
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/stage-2.mp3"
                },
                {
                  "boldText": "Stage 2: Recovering the Magic Shield"
                }
              ],
              "lineBreak": true
            },
            {
              "block": [
                {
                  "boldText": "2.1 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/2-1.mp3"
                },
                {
                  "text": "Explore the countryside and find the meadow."
                }
              ]
            },
            {
              "block": [
                {
                  "boldText": "2.2 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/2.2.mp3"
                },
                {
                  "text": "Take a carrot from the carrot patch."
                }
              ]
            },
            {
              "block": [
                {
                  "boldText": "2.3 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/2.3.mp3"
                },
                {
                  "text": "Find the goat pen nearby:"
                }
              ]
            },
            {
              "block": [
                {
                  "textIndent": true
                },
                {
                  "boldText": "2.3.1 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/2-3-1.mp3"
                },
                {
                  "text": "Open the gate"
                }
              ]
            },
            {
              "block": [
                {
                  "textIndent": true,
                  "boldText": "2.3.2 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/2-3-2.mp3"
                },
                {
                  "text": "2.3.3 Feed the carrot to the goat ➜ goat will now follow you."
                }
              ]
            },
            {
              "block": [
                {
                  "boldText": "2.4 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/2-4.mp3"
                },
                {
                  "text": "Lead the goat to the troll’s bridge:"
                }
              ]
            },
            {
              "block": [
                {
                  "boldText": "2.5 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/2-5.mp3"
                },
                {
                  "text": "The troll normally blocks the bridge and demands payment."
                }
              ]
            },
            {
              "block": [
                {
                  "textIndent": true,
                  "boldText": "2.5.1 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/2-5-1.mp3"
                },
                {
                  "text": "The troll normally blocks the bridge and demands payment."
                }
              ]
            },
            {
              "block": [
                {
                  "textIndent": true,
                  "boldText": "2.5.2 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/2-5-2.mp3"
                },
                {
                  "text": "With the goat, it charges and knocks the troll into the river, clearing the bridge permanently."
                }
              ]
            },
            {
              "block": [
                {
                  "boldText": "2.6 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/2-6.mp3"
                },
                {
                  "text": "Look for a large rock near the mountainside:"
                }
              ]
            },
            {
              "block": [
                {
                  "textIndent": true,
                  "boldText": "2.6.1 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/2-6-1.mp3"
                },
                {
                  "text": "Push the rock ➜ reveals a hidden cave entrance."
                }
              ]
            },
            {
              "block": [
                {
                  "textIndent": true,
                  "boldText": "2.6.2 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/2.6-2.mp3"
                },
                {
                  "text": "Enter the cave and retrieve the Magic Shield."
                }
              ]
            }
          ]
        },
        {
          "card": true,
          "blocks": [
            {
              "block": [
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/stage-3.mp3"
                },
                {
                  "boldText": "Stage 3: Recovering the Magic Mirror"
                }
              ],
              "lineBreak": true
            },
            {
              "block": [
                {
                  "boldText": "3.1 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/3-1.mp3"
                },
                {
                  "text": "Approach the witch’s gingerbread house when she is away."
                }
              ]
            },
            {
              "block": [
                {
                  "boldText": "3.2 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/3-2.mp3"
                },
                {
                  "text": "Inside the house:"
                }
              ]
            },
            {
              "block": [
                {
                  "textIndent": true,
                  "boldText": "3.2.1 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/3-2-1.mp3"
                },
                {
                  "text": "Open the cupboard ➜ find a piece of cheese"
                }
              ]
            },
            {
              "block": [
                {
                  "boldText": "3.2.2 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/3-2-2.mp3"
                },
                {
                  "textIndent": true,
                  "text": "Open the drawer ➜ find a note"
                }
              ]
            },
            {
              "block": [
                {
                  "textIndent": true,
                  "boldText": "3.2.3 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/3-2-3.mp3"
                },
                {
                  "text": "Upstairs:"
                }
              ]
            },
            {
              "block": [
                {
                  "doubleTextIndent": true,
                  "boldText": "3.2.3.1 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/3-2-3-1.mp3"
                },
                {
                  "text": "Open the chest ➜ find jewels"
                }
              ]
            },
            {
              "block": [
                {
                  "doubleTextIndent": true,
                  "boldText": "3.2.3.2 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/3-2-3-2.mp3"
                },
                {
                  "text": "Open the drawer ➜ find a carving knife"
                }
              ]
            },
            {
              "block": [
                {
                  "boldText": "3.3 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/3-3.mp3"
                },
                {
                  "text": "Avoid being caught by the witch, or she will turn you to stone."
                }
              ]
            },
            {
              "block": [
                {
                  "boldText": "3.4 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/3-4.mp3"
                },
                {
                  "text": "To remove the witch permanently:"
                }
              ]
            },
            {
              "block": [
                {
                  "textIndent": true,
                  "boldText": "3.4.1 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/3-4-1.mp3"
                },
                {
                  "text": "Wait outside until she appears"
                }
              ]
            },
            {
              "block": [
                {
                  "textIndent": true,
                  "boldText": "3.4.2 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/3-4-2.mp3"
                },
                {
                  "text": "Lure her inside"
                }
              ]
            },
            {
              "block": [
                {
                  "textIndent": true,
                  "boldText": "3.4.3 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/3-4-3.mp3"
                },
                {
                  "text": "Push her into the oven"
                }
              ]
            },
            {
              "block": [
                {
                  "boldText": "3.5 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/3-5.mp3"
                },
                {
                  "text": "Go upstairs into her bedroom, open the closet ➜ recover the Magic Mirror"
                }
              ]
            }
          ]
        },
        {
          "card": true,
          "blocks": [
            {
              "block": [
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/stage-4.mp3"
                },
                {
                  "boldText": "Stage 4: Recovering the Magic Chest"
                }
              ],
              "lineBreak": true
            },
            {
              "block": [
                {
                  "boldText": "4.1 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/4-1.mp3"
                },
                {
                  "text": "Head north to the giant’s house."
                }
              ]
            },
            {
              "block": [
                {
                  "boldText": "4.2 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/4-2.mp3"
                },
                {
                  "text": "Prepare by collecting items:"
                }
              ]
            },
            {
              "block": [
                {
                  "textIndent": true,
                  "boldText": "4.2.1 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/4-2-1.mp3"
                },
                {
                  "text": "Pick up pebbles near the river"
                }
              ]
            },
            {
              "block": [
                {
                  "textIndent": true,
                  "boldText": "4.2.2 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/4-2-2.mp3"
                },
                {
                  "text": "Find and use the sling"
                }
              ]
            },
            {
              "block": [
                {
                  "textIndent": true,
                  "boldText": "4.2.3 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/4-2-3.mp3"
                },
                {
                  "text": "At the well, tie the rope to the bucket, climb down, and swim through the passage ➜ optional treasure for points"
                }
              ]
            },
            {
              "block": [
                {
                  "textIndent": true,
                  "boldText": "4.2.4 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/4-2-4.mp3"
                },
                {
                  "text": "Fill the bucket with water before leaving"
                }
              ]
            },
            {
              "block": [
                {
                  "boldText": "4.3 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/4-3.mp3"
                },
                {
                  "text": "Deal with the giant:"
                }
              ]
            },
            {
              "block": [
                {
                  "textIndent": true,
                  "boldText": "4.3.1 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/4-3-1.mp3"
                },
                {
                  "text": "Wait for him to fall asleep"
                }
              ]
            },
            {
              "block": [
                {
                  "textIndent": true,
                  "boldText": "4.3.2 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/4-3-2.mp3"
                },
                {
                  "text": "OR throw water from the bucket in his face ➜ stun him"
                }
              ]
            },
            {
              "block": [
                {
                  "textIndent": true,
                  "boldText": "4.3.3 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/4-3-3.mp3"
                },
                {
                  "text": "OR use sling and pebbles to defeat him"
                }
              ]
            },
            {
              "block": [
                {
                  "boldText": "4.4 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/4-4.mp3"
                },
                {
                  "text": "Enter the giant’s house, open the chest ➜ claim the Magic Chest (provides endless gold)"
                }
              ]
            }
          ]
        },
        {
          "card": true,
          "blocks": [
            {
              "block": [
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/stage-5.mp3"
                },
                {
                  "boldText": "Stage 5: Completing the Quest"
                }
              ],
              "lineBreak": true
            },
            {
              "block": [
                {
                  "boldText": "5.1 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/5-1.mp3"
                },
                {
                  "text": "Return to King Edward’s castle with all three treasures:"
                }
              ]
            },
            {
              "block": [
                {
                  "textIndent": true,
                  "boldText": "5.1.1 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/5-1-1.mp3"
                },
                {
                  "text": "Magic Mirror"
                }
              ]
            },
            {
              "block": [
                {
                  "textIndent": true,
                  "boldText": "5.1.2 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/5-1-2.mp3"
                },
                {
                  "text": "Magic Shield"
                }
              ]
            },
            {
              "block": [
                {
                  "textIndent": true,
                  "boldText": "5.1.3 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/5-1-3.mp3"
                },
                {
                  "text": "Magic Chest"
                }
              ]
            },
            {
              "block": [
                {
                  "boldText": "5.2 "
                },
                {
                  "audio": true,
                  "audioSrc": "/assets/audio/extras/games/sierra/kings-quest-I/5-2.mp3"
                },
                {
                  "text": "Enter the throne room; King Edward dies peacefully, and Sir Graham is crowned the new ruler of Daventry."
                }
              ]
            },
            {
              "block": [
                {
                  "text": "Quest complete!"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
