    {
      "text": [
        {
          "blocks": [
            {
              "block": [
                {
                  "boldText": "Sweet Child O' Mine"
                }
              ]
            },
            {
              "block": [
                {
                  "ptText": "Minha Doce Criança"
                }
              ]
            }
          ]
        },
        {
          "blocks": [
            {
              "block": [
                {
                  "text": "She's got a smile that it seems to me"
                }
              ]
            },
            {
              "block": [
                {
                  "ptText": "Ela tem um sorriso que parece"
                }
              ]
            }
          ]
        },
        {
          "blocks": [
            {
              "block": [
                {
                  "text": "Reminds me of childhood memories"
                }
              ]
            },
            {
              "block": [
                {
                  "ptText": "Me lembrar de memórias de infância"
                }
              ]
            }
          ]
        },
        {
          "blocks": [
            {
              "block": [
                {
                  "text": "Where everything was as fresh"
                }
              ]
            },
            {
              "block": [
                {
                  "ptText": "Onde tudo era fresco"
                }
              ]
            }
          ]
        },
        {
          "blocks": [
            {
              "block": [
                {
                  "text": "As the bright blue sky"
                }
              ]
            },
            {
              "block": [
                {
                  "ptText": "Como o brilhante céu azul"
                }
              ]
            }
          ]
        },
        {
          "blocks": [
            {
              "block": [
                {
                  "text": "Now and then when I see her face"
                }
              ]
            },
            {
              "block": [
                {
                  "ptText": "Às vezes, quando eu vejo seu rosto"
                }
              ]
            }
          ]
        },
        {
          "blocks": [
            {
              "block": [
                {
                  "text": "She takes me away to that special place"
                }
              ]
            },
            {
              "block": [
                {
                  "ptText": "Ela me leva para aquele lugar especial"
                }
              ]
            }
          ]
        },
        {
          "blocks": [
            {
              "block": [
                {
                  "text": "And if I stare too long"
                }
              ]
            },
            {
              "block": [
                {
                  "ptText": "E se eu olhar por muito tempo"
                }
              ]
            }
          ]
        },
        {
          "blocks": [
            {
              "block": [
                {
                  "text": "I'd probably break down and cry"
                }
              ]
            },
            {
              "block": [
                {
                  "ptText": "Provavelmente perderia o controle e choraria"
                }
              ]
            }
          ]
        },
        {
          "blocks": [
            {
              "block": [
                {
                  "text": "Oh, oh, oh, sweet child of mine"
                }
              ]
            },
            {
              "block": [
                {
                  "ptText": "Oh, oh, oh, minha doce criança"
                }
              ]
            }
          ]
        },
        {
          "blocks": [
            {
              "block": [
                {
                  "text": "Oh, oh, oh, sweet love of mine"
                }
              ]
            },
            {
              "block": [
                {
                  "ptText": "Oh, oh, oh, meu doce amor"
                }
              ]
            }
          ]
        },
        {
          "blocks": [
            {
              "block": [
                {
                  "text": "She's got eyes of the bluest skies"
                }
              ]
            },
            {
              "block": [
                {
                  "ptText": "Ela tem olhos iguais aos céus mais azuis"
                }
              ]
            }
          ]
        },
        {
          "blocks": [
            {
              "block": [
                {
                  "text": "As if they thought of rain"
                }
              ]
            },

            {
              "block": [
                {
                  "ptText": "Como se eles pensassem na chuva"
                }
              ]
            }
          ]
        },
        {
          "blocks": [
            {
              "block": [
                {
                  "text": "I hate to look into those eyes"
                }
              ]
            },
            {
              "block": [
                {
                  "ptText": "Odeio olhar para dentro daqueles olhos"
                }
              ]
            }
          ]
        },
        {
          "blocks": [
            {
              "block": [
                {
                  "text": "And see an ounce of pain"
                }
              ]
            },
            {
              "block": [
                {
                  "ptText": "E ver um pingo de dor"
                }
              ]
            }
          ]
        },
        {
          "blocks": [
            {
              "block": [
                {
                  "text": "Her hair reminds me of a warm safe place"
                }
              ]
            },
            {
              "block": [
                {
                  "ptText": "O cabelo dela me lembra um refúgio aconchegante"
                }
              ]
            }
          ]
        },
        {
          "blocks": [
            {
              "block": [
                {
                  "text": "Where, as a child, I'd hide"
                }
              ]
            },
            {
              "block": [
                {
                  "ptText": "Onde, quando criança, eu me escondia"
                }
              ]
            }
          ]
        },
        {
          "blocks": [
            {
              "block": [
                {
                  "text": "And pray for the thunder and the rain"
                }
              ]
            },
            {
              "block": [
                {
                  "ptText": "E rezava para que o trovão e a chuva"
                }
              ]
            }
          ]
        },
        {
          "blocks": [
            {
              "block": [
                {
                  "text": "To quietly pass me by"
                }
              ]
            },
            {
              "block": [
                {
                  "ptText": "Passassem quietos por mim"
                }
              ]
            }
          ]
        },
