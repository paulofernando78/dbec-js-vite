          "blocks": [
            {
              "block": [
                {
                  "boldText": "Rusty Cage"
                }
              ]
            },
            {
              "block": [
                {
                  "ptText": "Gaiola Enferrujada (Simbolizado um estado de aprisionamento)"
                }
              ]
            }
          ]
        },
        {
          "blocks": [
            {
              "block": [
                {
                  "text": "You wired me awake"
                }
              ]
            },
            {
              "block": [
                {
                  "ptText": "Você me amarrou enquanto eu acordava"
                }
              ]
            }
          ]
        },
        {
          "blocks": [
            {
              "block": [
                {
                  "text": "And hit me with a hand of broken nails"
                }
              ]
            },
            {
              "block": [
                {
                  "ptText": "E me bateu com uma mão cheia de pregos quebrados"
                }
              ]
            }
          ]
        },
        {
          "blocks": [
            {
              "block": [
                {
                  "text": "You tied my lead and pulled my chain"
                }
              ]
            },
            {
              "block": [
                {
                  "ptText": "Você testou meus limites e puxou minha corrente"
                }
              ]
            }
          ]
        },
        {
          "blocks": [
            {
              "block": [
                {
                  "text": "To watch my blood begin to boil"
                }
              ]
            },
            {
              "block": [
                {
                  "ptText": "Para assistir meu sangue começar a ferver"
                }
              ]
            }
          ]
        },
        {
          "blocks": [
            {
              "block": [
                {
                  "text": "But I'm gonna break"
                }
              ]
            },
            {
              "block": [
                {
                  "ptText": "Mas eu vou quebrar"
                }
              ]
            }
          ]
