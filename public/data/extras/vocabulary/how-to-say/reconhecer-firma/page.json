              "block": [
                {
                  "audioSrc": "/assets/audio/extras/vocabulary/how-to-say/reconhecer-firma/the-signature-may.mp3"
                },
                {
                  "boldText": "• "
                },
                {
                  "text": "The signature may be notarized at Public Notaries and Consular Representations in Brazil to be officially accepted. "
