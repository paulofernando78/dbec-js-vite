                {
                  "boldText": "• "
                },
                {
                  "text": "They raised "
                },
                {
                  "underlinedText": "the flag"
                },
                {
                  "text": " during the ceremony. "
                },
                {
                  "ptText": "Eles hastearam a bandeira durante a cerimônia."
                }
