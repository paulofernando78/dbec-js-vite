            },
            {
              "block": [
                {
                  "audioSrc": "/assets/audio/extras/vocabulary/which-one/raise-rise/the-teacher-raised.mp3"
                },
                {
                  "boldText": "• "
                },
                {
                  "text": "The teacher raised "
                },
                {
                  "underlinedText": "an important question"
                },
                {
                  "text": " in class. "
                },
                {
                  "ptText": "O professor levantou uma questão importante na aula."
                }
              ]
            },
            {
              "block": [
                {
                  "audioSrc": "/assets/audio/extras/vocabulary/which-one/raise-rise/the-company-raised.mp3"
                },
                {
                  "boldText": "• "
                },
                {
                  "text": "The company raised "
                },
                {
                  "underlinedText": "money"
                },
                {
                  "text": " for charity. "
                },
                {
                  "ptText": "A empresa arrecadou dinheiro para a caridade."
                }
              ]
            },
            {
              "block": [
                {
                  "audioSrc": "/assets/audio/extras/vocabulary/which-one/raise-rise/he-raised-his.mp3"
                },
                {
                  "boldText": "• "
                },
                {
                  "text": "He raised "
                },
                {
                  "underlinedText": "his eyebrows"
                },
                {
                  "text": " in surprise. "
                },
                {
                  "ptText": "Ele levantou as sobrancelhas em surpresa."
                }
              ]
            },
            {
              "block": [
                {
                  "audioSrc": "/assets/audio/extras/vocabulary/which-one/raise-rise/the-coach-raised.mp3"
                },
                {
                  "boldText": "• "
                },
                {
                  "text": "The coach raised "
                },
                {
                  "underlinedText": "the team’s confidence"
                },
                {
                  "text": " before the match."
                },
                {
                  "ptText": " O treinador aumentou a confiança do time antes da partida."
