              ]
            },
            {
              "block": [
                {
                  "audioSrc": "/assets/audio/extras/vocabulary/which-one/raise-rise/the-workers-raised.mp3"
                },
                {
                  "boldText": "• "
                },
                {
                  "text": "The workers raised "
                },
                {
                  "underlinedText": "a wall"
                },
                {
                  "text": " around the house. "
                },
                {
                  "ptText": "Os trabalhadores ergueram um muro ao redor da casa."
                }
              ]
            },
            {
              "block": [
                {
                  "audioSrc": "/assets/audio/extras/vocabulary/which-one/raise-rise/she-raised-the-baby.mp3"
                },
                {
                  "boldText": "• "
                },
                {
                  "text": "She raised "
                },
                {
                  "underlinedText": "the baby"
                },
                {
                  "text": " alone. "
                },
                {
                  "ptText": "Ela criou o bebê sozinha."
                }
