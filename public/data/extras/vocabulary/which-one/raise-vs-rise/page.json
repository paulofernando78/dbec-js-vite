    {
      "text": [
        {
          "blocks": [
            {
              "block": [
                {
                  "audioSrc": "/assets/audio/extras/vocabulary/which-one/raise-rise/raise.mp3"
                },
                {
                  "boldText": "Raise "
                },
                {
                  "markedText": "must have an object"
                },
                {
                  "text": " as it is a "
                },
                {
                  "markedText": "transitive verb"
                },
                {
                  "text": ". It is a regular verb; its three forms are raise, "
                },
                {
                  "text":	"raised "
                },
                {
                  "phonetics":	"/d/"
                },
                {
                  "text":	", "
                },
                {
                  "text":	"raised "
                },
                {
                  "phonetics":	"/d/"
                }

              ],
              "lineBreak": true
            },
            {
              "block": [
                {
                  "boldText": "Examples"
                }
              ],
              "lineBreak": true
            },
            {
              "block": [
                {
                  "audioSrc": "/assets/audio/extras/vocabulary/which-one/raise-rise/raise-your-hands.mp3"
                },
                {
                  "boldText": "• "
                },
                {
                  "text": "Raise "
                },
                {
                  "underlinedText": "your hand"
                },
                {
                  "text": " if you know the answer. "
                },
                {
                  "ptText": "Levante a mão se você souber a resposta."
                }
              ]
            },
            {
              "block": [
                {
                  "audioSrc": "/assets/audio/extras/vocabulary/which-one/raise-rise/we-need-to-raise.mp3"
                },
                {
                  "boldText": "• "
                },
                {
                  "text": "We need to raise "
                },
                {
                  "underlinedText": "the flag"
                },
                {
                  "text": " before the event begins. "
                },
                {
                  "ptText": "Precisamos hastear a bandeira antes que o evento comece."
                }
              ]
            },
            {
              "block": [
                {
                  "audioSrc": "/assets/audio/extras/vocabulary/which-one/raise-rise/our-favorite-restaurant.mp3"
                },
                {
                  "boldText": "• "
                },
                {
                  "text": "Our favourite restaurant has raised  "
                },
                {
                  "underlinedText": "its prices"
                },
                {
                  "text": " again. It’s getting very expensive. "
                },
                {
                  "ptText": "Nosso restaurante favorito aumentou os preços novamente. Está ficando muito caro."
                }
              ]
            },
            {
              "block": [
                {
                  "audioSrc": "/assets/audio/extras/vocabulary/which-one/raise-rise/the-government-plans-to-raise.mp3"
                },
                {
                  "text": "The government plans to raise "
                },
                {
                  "underlinedText":	"taxes"
                },
                {
                  "text":	" next year. "
                },
                {
                  "ptText": "O governo planeja aumentar os impostos no próximo ano."
                }
              ]
            },
            {
              "block": [
                {
                  "audioSrc": "/assets/audio/extras/vocabulary/which-one/raise-rise/she-raised.mp3"
                },
                {
                  "boldText": "• "
                },
                {
                  "text": "She raised "
                },
                {
                  "underlinedText": "her voice"
                },
                {
                  "text": " to get everyone’s attention."
                },
                {
                  "ptText": " Ela levantou a voz para chamar a atenção de todos."
                }
              ]
            },
            {
              "block": [
                {
                  "audioSrc": "/assets/audio/extras/vocabulary/which-one/raise-rise/they-raised-the-salary.mp3"
