              ]
            },
            {
              "block": [
                {
                  "audioSrc": "/assets/audio/extras/vocabulary/which-one/raise-rise/airplanes-rise.mp3"
                },
                {
                  "boldText": "• "
                },
                {
                  "text": "Airplanes rise into the sky shortly after takeoff. "
                },
                {
                  "ptText": "Os aviões sobem para o céu logo após a decolagem."
                },
                {
                  "ptText": "..."
