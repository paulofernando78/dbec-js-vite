      "text": [
        {
          "card": true,
          "blocks": [
            {
              "block": [
                {
                  "boldText": "Lesson 3 • Ted’s Day at School"
                }
              ],
              "lineBreak": true
            },
            {
              "block": [
                {
                  "text": "Ted tells his parents he did poorly on his cheтistry test. They tell him he needs to get serious and study more."
                }
              ]
            }
          ]
        },
        {
          "card": false,
          "blocks": [
            {
              "block": [
                {
                  "boldText": "Susan: "
                },
                {
                  "text": "How was your day at school today, Ted?"
                }
              ],
              "lineBreak": true
            },
            {
              "block": [
                {
                  "boldText": "Ted: "
                },
                {
                  "text": "Bad. I had a chemistry test, and I "
                },
                {
                  "markedText": "blew it"
                },
                {
                  "text": "!"
                }
              ],
              "lineBreak": true
            },
            {
              "block": [
                {
                  "boldText": "Susan: "
                },
                {
                  "text": "Maybe if you didn't "
                },
                {
                  "markedText": "cut class"
                },
                {
                  "text": " so often, you'd do better."
                }
              ],
              "lineBreak": true
            },
            {
              "block": [
                {
                  "boldText": "Bob: "
                },
                {
                  "text": "That's right, son. Stop "
                },
                {
                  "markedText": "slacking off"
                },
                {
                  "text": " and start "
                },
                {
                  "markedText": "hitting the books"
                },
                {
                  "text": "!"
                }
              ],
              "lineBreak": true
            },
            {
              "block": [
                {
                  "boldText": "Ted: "
                },
                {
                  "text": "But I "
                },
                {
                  "markedText": "can't stand"
                },
                {
                  "text": " chemistry class. Besides, it's a "
                },
                {
                  "markedText": "lost cause"
                },
                {
                  "text": ". That class is way "
                },
                {
                  "markedText": "over my head"
                },
                {
                  "text": "."
                }
              ],
              "lineBreak": true
            },
            {
              "block": [
                {
                  "boldText": "Susan: "
                },
                {
                  "text": "You need to "
                },
                {
                  "markedText": "buckle down"
                },
                {
                  "text": "."
                }
              ],
              "lineBreak": true
            },
            {
              "block": [
                {
                  "boldText": "Ted: "
                },
                {
                  "text": "When I'm a famous musician, people won't "
                },
                {
                  "markedText": "give a hoot"
                },
                {
                  "text": " about my knowledge of atoms and molecules."
                }
              ],
              "lineBreak": true
            },
            {
              "block": [
                {
                  "boldText": "Bob: "
                },
                {
                  "text": "That's "
                },
                {
                  "markedText": "beside the point"
                },
                {
                  "text": "."
                }
              ],
              "lineBreak": true
            },
            {
              "block": [
                {
                  "boldText": "Susan: "
                },
                {
                  "text": "We know you have your "
                },
                {
                  "markedText": "heart set on"
                },
                {
                  "text": " going to New York University."
                }
              ],
              "lineBreak": true
            },
            {
              "block": [
                {
                  "boldText": "Bob: "
                },
                {
                  "text": "And you don't "
                },
                {
                  "markedText": "stand a chance"
                },
                {
                  "text": " of getting in there with such poor grades!"
                }
              ],
              "lineBreak": true
            }
          ]
        }
      ]
