              "word": "cost an arm and a leg",
              "imageSrc": "/assets/images/general/cost-an-arm-and-a-leg.avif"
            },
            {
              "word": "go back to the drawing board",
              "imageSrc": "/assets/images/general/go-back-to-the-drawing-board.avif"
              
            },
            {
              "word": "sharp as a tack",
              "imageSrc": "/assets/images/general/sharp-as-a-tack.avif"
            },
            {
              "word": "give someone the creeps",
              "imageSrc": "/assets/images/general/give-someone-the-creeps.avif"
            },
            {
              "word": "break the news",
              "imageSrc": "/assets/images/general/break-the-news.avif"
