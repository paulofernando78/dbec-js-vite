                },
                {
                  "option": "day",
                  "isCorrect": true
                }
              ]
            },
            {
              "question": [
                {
                  "text": "2.8  Fortunately, Bob no longer has to put _____ with his stupid boss at the furniture store."
                }
              ],
              "options": [
                {
                  "option": "over",
                  "isCorrect": true
                },
                {
                  "option": "in",
