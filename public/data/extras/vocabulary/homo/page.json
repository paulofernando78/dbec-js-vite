                {
                  "text": "A "
                },
                {
                  "boldText": "homograph"
                },
                {
                  "text": " is a word that has the "
                },
                {
                  "markedText": "same spelling"
                },
                {
                  "text": " as another word but has a "
                },
                {
                  "markedText": "different pronunciation"
                },
                {
                  "text": " and a different meaning. The suffix "
                },
                {
                  "markedText": "–graph"
                },
                {
                  "text": " comes from Greek and means “written,” showing that the words are the same in writing."
                }
              ]
            }
